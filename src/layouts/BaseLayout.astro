---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, buildAlternates, htmlLangAttr, getI18n } from '../i18n/ui';
import { ogLocale } from '../config';
import { attraction } from '../config/attraction';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const htmlLang = htmlLangAttr(lang);
const alts = buildAlternates(path);
const canonical = alts[lang] ?? alts.ja;
const { messages } = getI18n(Astro.url);

const entity = messages.entity ?? {};
const entityName: string = entity.name ?? attraction.fullName;
const entityAlt: string[] = Array.isArray(entity.alternateName)
  ? entity.alternateName
  : [attraction.fullName, `${attraction.city} ${attraction.fullName}`];
const entityDescription: string = entity.schemaDescription ?? description;

const abs = (p: string) => `${attraction.baseUrl}${p}`;
const heroImage = abs(attraction.heroImage);
const galleryImages = attraction.images.map((n) => abs(`${attraction.galleryPrefix}${n}.jpg`));

// ── 1. 结构化数据：景点实体绑定（含 @id / image / geo / NAP）────────────
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  '@id': `${attraction.baseUrl}/#attraction`,
  name: entityName,
  alternateName: entityAlt,
  description: entityDescription,
  url: canonical,
  image: galleryImages,
  isAccessibleForFree: true,
  publicAccess: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: attraction.streetAddress,
    addressLocality: attraction.city,
    addressRegion: attraction.province,
    postalCode: attraction.postalCode,
    addressCountry: attraction.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude,
  },
  hasMap: attraction.mapsShareUrl,
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  telephone: attraction.telephone,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: String(attraction.ratingValue),
    reviewCount: String(attraction.reviewCount),
  },
  sameAs: [attraction.mapsShareUrl, attraction.govTourismUrl, attraction.govtCityUrl],
};

// ── 2. FAQ 结构化数据：抢占 Featured Snippet / AI 概览卡片 ──────────────
const faqEntities = (messages.faq?.categories ?? [])
  .flatMap((cat: any) => cat.items ?? [])
  .filter((item: any) => item?.q && item?.a)
  .map((item: any) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  }));

const faqLd = faqEntities.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqEntities,
    }
  : null;

// ── 3. 面包屑结构化数据：地理面包屑与归属层级 ──────────────────────────
const homeUrl = `${attraction.baseUrl}/${lang}`;
const breadcrumbLd = path
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: entityName, item: homeUrl },
        { '@type': 'ListItem', position: 2, name: title, item: canonical },
      ],
    }
  : null;

const alternateLocales = Object.entries(ogLocale)
  .filter(([code]) => code !== lang)
  .map(([, value]) => value);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh" href={alts.zh} />
    <link rel="alternate" hreflang="en" href={alts.en} />
    <link rel="alternate" hreflang="ja" href={alts.ja} />
    <link rel="alternate" hreflang="ko" href={alts.ko} />
    <link rel="alternate" hreflang="x-default" href={alts.xDefault} />

    <!-- 地理实体元数据（辅助本地实体绑定） -->
    <meta name="geo.placename" content={`${attraction.fullName}, ${attraction.city}, ${attraction.province}`} />
    <meta name="geo.region" content={attraction.provinceCode} />
    <meta name="geo.position" content={`${attraction.latitude};${attraction.longitude}`} />
    <meta name="ICBM" content={`${attraction.latitude}, ${attraction.longitude}`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={entityName} />
    <meta property="og:locale" content={ogLocale[lang] ?? lang} />
    {alternateLocales.map((loc) => (
      <meta property="og:locale:alternate" content={loc} />
    ))}
    <meta property="og:image" content={heroImage} />
    <meta property="og:image:alt" content={`${entityName} in ${attraction.city}, ${attraction.country}`} />
    <meta property="og:image:width" content={String(attraction.heroImageWidth)} />
    <meta property="og:image:height" content={String(attraction.heroImageHeight)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={heroImage} />
    <meta name="twitter:image:alt" content={`${entityName} in ${attraction.city}, ${attraction.country}`} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2d6375" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={entityName} />
    <meta name="application-name" content={entityName} />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-512.png" />

    <meta name="google-adsense-account" content="ca-pub-XXXXXXXXXX" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    {faqLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)}></script>
    )}
    {breadcrumbLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)}></script>
    )}

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google tag (gtag.js) — GA4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-HXM22WWPKP');
    </script>

    <!-- PWA Service Worker -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const h = messages.history;
const paragraphs = h.paragraphs ?? [];
const timeline = h.timeline ?? [];
const stories = h.stories ?? [];
const facts = h.facts ?? [];
---

<section id="history" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{h.title}</h2>
    <p class="text-center text-base sm:text-lg mb-10 max-w-3xl mx-auto leading-relaxed" style="color: var(--text-secondary);">{h.subtitle}</p>

    <!-- 导语 -->
    <div class="space-y-4 mb-12">
      {paragraphs.map((text) => (
        <p class="text-base leading-relaxed" style="color: var(--text-secondary);" set:html={text}></p>
      ))}
    </div>

    <!-- 年表 -->
    <h3 class="font-display text-2xl font-semibold mb-6" style="color: var(--text-primary);">{h.timelineTitle}</h3>
    <ol class="mb-12">
      {timeline.map((item, i) => (
        <li class="relative pl-8 pb-7 last:pb-0">
          {i < timeline.length - 1 && (
            <span class="absolute left-[5px] top-3 bottom-0 w-px" style="background: var(--border-color);"></span>
          )}
          <span class="absolute left-0 top-[0.4rem] w-2.5 h-2.5 rounded-full" style="background: var(--accent);"></span>
          <p class="text-xs font-semibold tracking-[0.14em] mb-1" style="color: var(--accent);">{item.year}</p>
          <p class="font-display text-lg font-semibold mb-1" style="color: var(--text-primary);">{item.title}</p>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);" set:html={item.text}></p>
        </li>
      ))}
    </ol>

    <!-- 由来与故事 -->
    <h3 class="font-display text-2xl font-semibold mb-6" style="color: var(--text-primary);">{h.storiesTitle}</h3>
    <div class="grid gap-5 sm:grid-cols-2 mb-10">
      {stories.map((story) => (
        <article class="rounded-2xl border p-5" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <p class="font-semibold mb-2 flex items-start gap-2" style="color: var(--text-primary);">
            <span class="text-xl leading-none" aria-hidden="true">{story.icon}</span>
            <span>{story.title}</span>
          </p>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);" set:html={story.text}></p>
        </article>
      ))}
    </div>

    <!-- 豆知識 -->
    <div class="rounded-2xl border p-5 sm:p-6" style="background: var(--card-bg); border-color: var(--border-color);">
      <p class="text-sm font-semibold mb-3" style="color: var(--text-primary);">📌 {h.factsTitle}</p>
      <ul class="grid gap-2.5 sm:grid-cols-2 text-sm leading-relaxed">
        {facts.map((fact) => (
          <li class="flex gap-2">
            <span class="shrink-0 mt-[0.35rem] w-1.5 h-1.5 rounded-full" style="background: var(--accent);"></span>
            <span style="color: var(--text-secondary);" set:html={fact}></span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

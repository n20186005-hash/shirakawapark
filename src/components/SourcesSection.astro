---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const s = messages.sources;
const items = s.items ?? [];
---

<section id="sources" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="font-display text-2xl sm:text-3xl font-semibold mb-3" style="color: var(--text-primary);">
      {s.title}
    </h2>
    <p class="text-base leading-relaxed mb-8" style="color: var(--text-secondary);">{s.subtitle}</p>

    <ul class="grid sm:grid-cols-2 gap-4">
      {items.map((item) => (
        <li
          class="rounded-2xl p-5 border h-full"
          style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);"
        >
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium hover:opacity-70 break-words"
            style="color: var(--accent);"
          >
            {item.name} ↗
          </a>
          {item.publisher && (
            <p class="text-xs mt-1" style="color: var(--text-muted);">{item.publisher}</p>
          )}
          <p class="text-sm leading-relaxed mt-2" style="color: var(--text-secondary);">{item.note}</p>
        </li>
      ))}
    </ul>

    <p class="text-xs leading-relaxed mt-8" style="color: var(--text-muted);">{s.licenseNote}</p>
  </div>
</section>
